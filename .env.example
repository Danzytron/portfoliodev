# ==============================================================================
# Contact Form Email Delivery (Server-Side Only)
# ==============================================================================
# Never prefix these variables with NEXT_PUBLIC_ to keep them private.
#
# 1. Sign up for a free Resend account at https://resend.com
# 2. Create an API Key in your Resend Dashboard (starts with "re_...")
# 3. Add these variables to your Vercel Project Settings > Environment Variables:
#
# Your Resend API Key:
RESEND_API_KEY=re_your_api_key_here

# Recipient inbox where messages are sent:
CONTACT_TO_EMAIL=rdelarmente0@gmail.com

# Verified sender address. 
# While getting started, Resend provides a free sandbox sender:
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Optional: Production site URL (e.g. https://portfoliodev.vercel.app)
NEXT_PUBLIC_SITE_URL=https://portfoliodev.vercel.app
