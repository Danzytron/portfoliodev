# Contact form email delivery (server-side only — never prefix with NEXT_PUBLIC_)
# Create a free key at https://resend.com and copy this file to .env.local
RESEND_API_KEY=
# Where messages should be delivered (your inbox)
CONTACT_TO_EMAIL=
# Verified sender. Resend's test sender works while you are getting started.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Optional: canonical site URL used for metadata (e.g. https://your-domain.com)
NEXT_PUBLIC_SITE_URL=
